---
// Serviços em ÍNDICE (P2 F9; DESENHO §4 item 4). Cada serviço é uma linha
// <a> (código 01–09 em Barlow tabular + nome + resumo + seta), dentro dos
// grupos de oficina.gruposServico, e o que sobra vira a faixa "Peças e
// acessórios" (oficina.faixaPecas). O grupo se arranja pela própria
// largura (container query): foto-guia ao lado das linhas quando cabe.
// Fotos: as 3 a partir de 768; abaixo disso só a do primeiro grupo.
// Hover: a seta desliza e o filete âmbar cresce. Sem Card e sem ícone de
// serviço (a seta é o único ícone). O traço de entrada das linhas é da M4:
// cada linha leva --linha (posição no grupo) para o escalonamento.
import CabecalhoSecao from "@/components/ui/CabecalhoSecao.astro";
import Container from "@/components/ui/Container.astro";
import Foto from "@/components/ui/Foto.astro";
import Icone from "@/components/ui/Icone.astro";
import oficina, { afirmacoes } from "@/data/oficina";
import { whatsappServico } from "@/lib/links";

const porSlug = new Map(oficina.servicos.map((s) => [s.slug, s]));
const codigo = (n: number) => String(n).padStart(2, "0");

// Código contínuo na ordem da tela: grupos, depois a faixa.
let n = 0;
const grupos = oficina.gruposServico.map((grupo) => ({
  ...grupo,
  linhas: grupo.servicos.map((slug) => ({ servico: porSlug.get(slug)!, codigo: codigo(++n) })),
}));
const pecas = { servico: porSlug.get(oficina.faixaPecas)!, codigo: codigo(++n) };

// Linha divisória do índice (era a borda do <li>): elemento próprio para
// poder se traçar da esquerda na entrada (M4; global.css "Traço das linhas
// do índice"). Vem ANTES do <a> no <li>, então o filete de hover pinta
// por cima dela. Sem JS e com movimento reduzido ela está sempre inteira.
const classesTraco = "absolute inset-x-0 bottom-0 h-px origin-left bg-grafite-100";
const classesLinha =
  "group relative grid min-h-alvo grid-cols-[auto_1fr_auto] items-start gap-x-xs py-xs";
const classesFilete =
  "absolute inset-x-0 bottom-0 h-3xs origin-left scale-x-0 bg-ambar-500 transition-transform duration-base ease-padrao group-hover:scale-x-100 group-focus-visible:scale-x-100";
const classesSeta =
  "mt-3xs size-6 transition-transform duration-base ease-padrao group-hover:translate-x-3xs group-focus-visible:translate-x-3xs motion-reduce:transition-none";
---

<section id="servicos" aria-labelledby="servicos-titulo" class="py-2xl md:py-4xl">
  <Container>
    <div data-reveal>
      <CabecalhoSecao
        variante="etiqueta"
        idTitulo="servicos-titulo"
        eyebrow="Serviços"
        titulo="Mecânica completa para o dia a dia do seu carro"
        subtitulo={afirmacoes.orcamentoVemAntes.texto}
      />
    </div>

    <div class="mt-lg space-y-md md:mt-2xl md:space-y-2xl" data-indice>
      {
        grupos.map((grupo, i) => (
          <div class="@container" data-grupo={grupo.slotGuia} data-reveal>
            <div class="grid gap-sm @texto:grid-cols-12 @texto:items-start @texto:gap-lg">
              <Foto
                slot={grupo.slotGuia}
                sizes="(min-width: 1024px) 30vw, (min-width: 768px) 40vw, 100vw"
                class={i > 0 ? "max-md:hidden @texto:col-span-5" : "@texto:col-span-5"}
              />
              <div class="@texto:col-span-7">
                <h3 class="border-b-2 border-grafite-950 pb-2xs text-2xl leading-tight font-bold uppercase text-grafite-950">
                  {grupo.titulo}
                </h3>
                <ul role="list">
                  {grupo.linhas.map(({ servico, codigo }, j) => (
                    <li class="relative" style={`--linha: ${j}`}>
                      <span class={classesTraco} data-traco aria-hidden="true" />
                      <a
                        href={whatsappServico(servico.nome)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={classesLinha}
                        data-linha-servico={servico.slug}
                      >
                        <span class="font-display text-xl leading-tight font-extrabold text-ambar-700 tabular-nums">
                          {codigo}
                        </span>
                        <span>
                          <span class="block font-display text-xl leading-tight font-bold uppercase text-grafite-950">
                            {servico.nome}
                          </span>
                          <span class="mt-3xs block text-sm leading-snug text-grafite-500">{servico.resumo}</span>
                        </span>
                        <Icone nome="mdi:arrow-right" class={`${classesSeta} text-grafite-800`} />
                        <span class={classesFilete} aria-hidden="true" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }

      <!-- Faixa "Peças e acessórios": fora dos grupos, mas com a MESMA
           linha do índice — o painel escuro destoava do resto da lista. -->
      <div class="relative" data-faixa-pecas data-reveal>
        <span class={classesTraco} data-traco aria-hidden="true"></span>
        <a
          href={whatsappServico(pecas.servico.nome)}
          target="_blank"
          rel="noopener noreferrer"
          class={classesLinha}
          data-linha-servico={pecas.servico.slug}
        >
          <span class="font-display text-xl leading-tight font-extrabold text-ambar-700 tabular-nums">
            {pecas.codigo}
          </span>
          <span>
            <span class="block font-display text-xl leading-tight font-bold uppercase text-grafite-950">
              {pecas.servico.nome}
            </span>
            <span class="mt-3xs block text-sm leading-snug text-grafite-500">{pecas.servico.resumo}</span>
          </span>
          <Icone nome="mdi:arrow-right" class={`${classesSeta} text-grafite-800`} />
          <span class={classesFilete} aria-hidden="true" />
        </a>
      </div>
    </div>
  </Container>
</section>
